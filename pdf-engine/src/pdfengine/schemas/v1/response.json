{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdfengine.local/schemas/v1/response.json",
  "title": "Response envelope",
  "description": "Every response from every transport has this shape. Exactly one of result or error is present.",
  "type": "object",
  "required": ["apiVersion", "requestId", "ok", "warnings"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "v1" },
    "requestId": {
      "type": "string",
      "description": "Echoes the request, or 'unknown' when the request could not be parsed."
    },
    "ok": { "type": "boolean" },
    "result": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "required": ["code", "message", "details"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "engine_error",
            "parse_error",
            "unsupported_pdf",
            "unsupported_operation",
            "invalid_operation",
            "invalid_request",
            "renderer_unavailable",
            "render_error",
            "source_changed",
            "session_not_found"
          ]
        },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "required": ["result"] },
      "else": { "required": ["error"] }
    }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "required": ["pageCount", "pages"],
      "properties": {
        "pageCount": { "type": "integer", "minimum": 0 },
        "title": { "type": ["string", "null"] },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pageId", "index", "width", "height", "rotation"],
            "properties": {
              "pageId": { "type": "string" },
              "index": { "type": "integer", "minimum": 0 },
              "sourceIndex": { "type": ["integer", "null"] },
              "width": { "type": "number" },
              "height": { "type": "number" },
              "rotation": { "type": "integer", "enum": [0, 90, 180, 270] }
            }
          }
        }
      }
    },
    "read": {
      "type": "object",
      "description": "What this document can be read for, as opposed to edited into. Present only when a response describes an open session, because it describes a specific document.",
      "required": ["structuralEdit", "textContent"],
      "properties": {
        "structuralEdit": {
          "type": "object",
          "description": "Reordering, deleting, rotating, cropping, importing and saving. Always ready: these copy stream bytes through without decoding them.",
          "required": ["state", "detail"],
          "properties": {
            "state": { "type": "string", "enum": ["ready", "blocked"] },
            "detail": { "type": "string" }
          }
        },
        "textContent": {
          "type": "object",
          "description": "Anything that must look inside stream bytes. Blocked when the pages reach a stream whose filters this version cannot decode.",
          "required": ["state", "detail", "filters", "objectCount"],
          "properties": {
            "state": { "type": "string", "enum": ["ready", "blocked"] },
            "detail": {
              "type": "string",
              "description": "Human-readable reason when blocked, empty when ready."
            },
            "filters": {
              "type": "array",
              "description": "Sorted distinct names of the filters that could not be decoded. Empty when ready.",
              "items": { "type": "string" }
            },
            "objectCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct stream objects carrying those filters. Zero when ready."
            }
          }
        }
      }
    }
  }
}
